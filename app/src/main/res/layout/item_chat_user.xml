<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_jarvis_card"
        android:backgroundTint="@color/jarvis_cyan_muted"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="User Message"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtUserTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="COMMANDER"
            android:layout_gravity="end"
            android:textColor="@color/jarvis_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
