<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HelpActivity">

    <com.example.translateanywhere.ParticleView
        android:id="@+id/helpParticleBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/helpTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnHelpBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_active_session_outline"
            android:src="@drawable/abc_ic_ab_back_material"
            app:tint="@color/jarvis_cyan"
            android:contentDescription="Go Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="HELP CENTER"
            android:textColor="@color/jarvis_cyan"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/helpDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="@color/jarvis_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/helpTopBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/helpDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp">

            <!-- Section: System Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM OVERVIEW"
                android:textColor="@color/jarvis_text_highlight"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_jarvis_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="JARVIS (Just A Rather Very Intelligent System)"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Jarvis is a premium AI assistant designed for seamless interaction. It combines advanced intent extraction with local system control to provide a high-security, responsive automation experience."
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Section: How to Use -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="OPERATIONAL GUIDE"
                android:textColor="@color/jarvis_text_highlight"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_jarvis_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Wake Up Activation"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap the central mic button to activate Jarvis voice listener. Ensure the 'Wakeword Key' is set in System Controls for full encryption."
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="2. Profile Integrity"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Maintain an updated profile to enable personal identity features and secure access logs."
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Section: Offline Commands -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="SECURE OFFLINE PROTOCOLS"
                android:textColor="@color/jarvis_text_highlight"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_jarvis_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Manual Extraction Commands"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="If the server is offline, use these direct manual commands for zero-latency execution:"
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="4dp"
                    android:paddingStart="8dp"
                    android:text="• 'call to [name]' - Direct dial\n• 'open [app]' - Launch any installed app\n• 'play song [name]' - Media control\n• 'clear memory' - Cache optimization\n• 'go to sleep' - Deactivate Jarvis\n• 'enable/disable auto reply' - SMS automation"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="JARVIS OS CORE v1.0\nAll protocols are encrypted."
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="10sp"
                android:alpha="0.5" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
