<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/jarvis_bg_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACCESS DECRYPTOR"
        android:textColor="@color/jarvis_cyan"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etDialogKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_jarvis_card"
        android:hint="Enter Secure Key..."
        android:textColorHint="@color/jarvis_text_secondary"
        android:textColor="@color/jarvis_cyan"
        android:padding="16dp"
        android:inputType="textPassword"
        android:textSize="16sp"
        android:fontFamily="monospace"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="* This key is required for wakeword encryption"
        android:textColor="@color/jarvis_text_secondary"
        android:textSize="10sp"
        android:layout_marginTop="8dp"
        android:alpha="0.7"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="CANCEL"
            android:backgroundTint="@color/jarvis_card_bg"
            android:textColor="@color/jarvis_cyan"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginEnd="6dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnDialogSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="SAVE KEY"
            android:backgroundTint="@color/jarvis_cyan"
            android:textColor="#1A1C23"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginStart="6dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>
