<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsActivity">

    <com.example.translateanywhere.ParticleView
        android:id="@+id/settingsParticleBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/settingsTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnSettingsBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_active_session_outline"
            android:src="@drawable/abc_ic_ab_back_material"
            app:tint="@color/jarvis_cyan"
            android:contentDescription="Go Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="SYSTEM SETTINGS"
            android:textColor="@color/jarvis_cyan"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/settingsDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="@color/jarvis_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsTopBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp">

            <!-- Section: Preferences -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREFERENCES"
                android:textColor="@color/jarvis_text_highlight"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_jarvis_card"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="System Sound Feedback"
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/Widget.AppCompat.CompoundButton.Switch" />
            </LinearLayout>

            <!-- Section: Identity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="COMMANDER IDENTITY"
                android:textColor="@color/jarvis_text_highlight"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_jarvis_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Read-only User ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM UID (Non-changeable)"
                    android:textColor="@color/jarvis_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingsUserId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="JARVIS_USER_001"
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="14sp"
                    android:alpha="0.6"
                    android:paddingBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/jarvis_border"
                    android:layout_marginVertical="8dp"/>

                <!-- Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COMMANDER NAME"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etSettingsName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Update name"
                    android:textColor="@color/jarvis_text_primary"
                    android:textColorHint="@color/jarvis_text_secondary"
                    android:textSize="14sp"
                    android:paddingVertical="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/jarvis_border"
                    android:layout_marginVertical="8dp"/>

                <!-- Mobile -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOBILE PROTOCOL"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etSettingsMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Update mobile"
                    android:inputType="phone"
                    android:textColor="@color/jarvis_text_primary"
                    android:textColorHint="@color/jarvis_text_secondary"
                    android:textSize="14sp"
                    android:paddingVertical="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/jarvis_border"
                    android:layout_marginVertical="8dp"/>

                <!-- Location -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPERATIONAL BASE (Location)"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etSettingsLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Update location"
                    android:textColor="@color/jarvis_text_primary"
                    android:textColorHint="@color/jarvis_text_secondary"
                    android:textSize="14sp"
                    android:paddingVertical="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/jarvis_border"
                    android:layout_marginVertical="8dp"/>

                <!-- DOB -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BIRTH LOG (DOB)"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etSettingsDOB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="DD/MM/YYYY"
                    android:textColor="@color/jarvis_text_primary"
                    android:textColorHint="@color/jarvis_text_secondary"
                    android:textSize="14sp"
                    android:paddingVertical="8dp"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnSettingsSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="SAVE PROTOCOLS"
                android:backgroundTint="@color/jarvis_cyan"
                android:textColor="#1A1C23"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="SYSTEM CORE v1.0\nIdentity verified by Jarvis."
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="10sp"
                android:alpha="0.5" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
