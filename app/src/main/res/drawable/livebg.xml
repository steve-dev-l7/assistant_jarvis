<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#80FFFFFF"   android:centerColor="#00FFFFFF"  android:endColor="#33FFFFFF"     android:type="linear" />

            <corners android:radius="35dp" /> </shape>
    </item>

    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="33dp" /> </shape>
    </item>

</layer-list>