<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark glass fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E6000000"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- Glowing border layer (offset inward to simulate glow) -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#00FFAA00"/>
            <stroke android:width="1dp" android:color="#80FFAA00"/>
            <corners android:radius="23dp"/>
        </shape>
    </item>

    <!-- Bright inner amber stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1.5dp" android:color="#B3FFCC44"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
