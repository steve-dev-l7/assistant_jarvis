<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft Slate Fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E8EEF2"/><!-- C9D6DF with more opacity -->
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Subtle Border using 52616B -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#3352616B"/><!-- 20% of 52616B -->
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
