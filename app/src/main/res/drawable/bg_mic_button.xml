<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow (30% Gold) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#4DFFD700" />
            <size android:width="160dp" android:height="160dp" />
        </shape>
    </item>
    <!-- Inner Border (Gold) -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="@color/accent_gold" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Inner Circle Background (Pure Black) -->
    <item android:top="11dp" android:bottom="11dp" android:left="11dp" android:right="11dp">
        <shape android:shape="oval">
            <solid android:color="@color/bg_primary" />
        </shape>
    </item>
</layer-list>
